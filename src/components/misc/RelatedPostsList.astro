---
/**
 * 相关文章列表（客户端渲染，侧栏 widget 与移动端文末块共用）。
 *
 * 为什么不在服务端渲染列表：右侧栏在 #right-sidebar-static 内，不是 swup 容器，
 * 站内导航后 DOM 不被替换（SidebarTOC 同款约束，靠客户端重建）。这里统一走
 * 「SSR 骨架 + 客户端按当前文章计算填充」，swup:contentReplaced 后重算即可，
 * 无需把推荐结果穿透 MainGridLayout 四层 props。
 *
 * 数据源 = /api/allPostMeta.json（日历同款，共享 window.__allPostMetaCache 缓存）。
 * 推荐规则：同分类优先（标签重合数降序 → 发布时间近者优先），不足 3 篇用同标签
 * 文章补齐；再没有则整块移除（侧栏 widget 卡 / 移动端块一起消失）。
 */
import { url } from "@/utils/url-utils";

interface Props {
	variant?: "widget" | "compact";
	/** 当前文章 id（内容层 id，不含扩展名）；解析 URL 失败时的兜底 */
	currentId?: string;
	class?: string;
}

const { variant = "widget", currentId = "", class: className } = Astro.props;
const apiUrl = url("/api/allPostMeta.json");
---

<div
	class:list={["rp-root", `rp-${variant}`, className]}
	data-current-id={currentId}
	data-api-url={apiUrl}
>
	<div class="rp-skeleton" aria-hidden="true">
		{[0, 1, 2].map(() => <div class="rp-skeleton-row"><div class="rp-skeleton-line"></div></div>)}
	</div>
</div>

<script>
	// 推荐计算与渲染共用一套；页面可能同时存在侧栏与移动端两个实例
	const RP_MAX = 3;

	interface RpPostMeta {
		id: string;
		title: string;
		published: number;
		category: string;
		password: boolean;
		draft?: boolean;
		tags?: string[];
	}

	async function rpLoadMeta(apiUrl: string): Promise<RpPostMeta[]> {
		const w = window as any;
		if (w.__allPostMetaCache) return w.__allPostMetaCache as RpPostMeta[];
		const res = await fetch(apiUrl);
		if (!res.ok) throw new Error(`allPostMeta ${res.status}`);
		const data = (await res.json()) as RpPostMeta[];
		w.__allPostMetaCache = data;
		return data;
	}

	/** 从 location.pathname 解析当前文章 id；解析不出返回空串 */
	function rpCurrentIdFromLocation(): string {
		const m = location.pathname.replace(/\/+$/, "").match(/\/posts\/(.+)$/);
		return m ? m[1] : "";
	}

	/** 同分类优先 + 标签重合加权；不足补同标签；空则返回 [] */
	function rpPick(all: RpPostMeta[], currentId: string): RpPostMeta[] {
		const cur = all.find((p) => p.id === currentId);
		if (!cur) return [];
		const cands = all.filter(
			(p) => p.id !== currentId && !p.password && !p.draft,
		);
		const curTags = new Set((cur.tags ?? []).map((t) => t.toLowerCase()));
		const overlap = (p: RpPostMeta) =>
			(p.tags ?? []).filter((t) => curTags.has(t.toLowerCase())).length;
		const newer = (a: RpPostMeta, b: RpPostMeta) => b.published - a.published;

		const list = cands
			.filter((p) => p.category && p.category === cur.category)
			.sort((a, b) => overlap(b) - overlap(a) || newer(a, b))
			.slice(0, RP_MAX);
		if (list.length < RP_MAX) {
			const seen = new Set(list.map((p) => p.id));
			const sameTag = cands
				.filter((p) => !seen.has(p.id) && overlap(p) > 0)
				.sort((a, b) => overlap(b) - overlap(a) || newer(a, b));
			list.push(...sameTag.slice(0, RP_MAX - list.length));
		}
		return list;
	}

	function rpRenderRoot(root: HTMLElement, all: RpPostMeta[]): boolean {
		// URL 解析优先（swup 切页后 data 属性还是旧页的）；解析不出回退 SSR 兜底值
		const currentId = rpCurrentIdFromLocation() || root.dataset.currentId || "";
		const picked = rpPick(all, currentId);
		if (picked.length === 0) return false;

		const base = root.dataset.apiUrl?.replace(/\/api\/allPostMeta\.json$/, "") ?? "";
		const frag = document.createDocumentFragment();
		picked.forEach((post, idx) => {
			const a = document.createElement("a");
			a.href = `${base}/posts/${post.id}/`;
			a.className =
				"rp-item group flex items-center gap-2 transition" +
				(idx < picked.length - 1 ? " rp-item-divided" : "");
			a.title = post.title;

			const title = document.createElement("span");
			title.className = "rp-title";
			title.textContent = post.title;

			const cat = document.createElement("span");
			cat.className = "rp-cat shrink-0";
			cat.textContent = post.category;

			a.appendChild(title);
			if (post.category) a.appendChild(cat);
			frag.appendChild(a);
		});

		root.replaceChildren(frag);
		return true;
	}

	function rpRemoveBlock(root: HTMLElement) {
		// 侧栏实例连带 widget 卡移除；移动端实例连带外层卡片移除
		root.closest("widget-layout")?.remove();
		root.closest("[data-rp-block]")?.remove();
		root.remove();
	}

	async function rpRenderAll() {
		const roots = Array.from(
			document.querySelectorAll<HTMLElement>(".rp-root"),
		);
		if (roots.length === 0) return;
		let all: RpPostMeta[] | null = null;
		try {
			all = await rpLoadMeta(roots[0].dataset.apiUrl ?? "");
		} catch {
			// 数据取不到：静默收起，不占位
			roots.forEach(rpRemoveBlock);
			return;
		}
		for (const root of roots) {
			try {
				if (!rpRenderRoot(root, all)) rpRemoveBlock(root);
			} catch {
				rpRemoveBlock(root);
			}
		}
	}

	if (!(window as any).__rpInit) {
		(window as any).__rpInit = true;
		const kick = () => setTimeout(rpRenderAll, 50);
		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", kick);
		} else {
			kick();
		}
		// 右侧栏不在 swup 容器内：切页后重算；移动端块随 #swup-container 换新骨架后同样重算
		document.addEventListener("swup:contentReplaced", kick);
		document.addEventListener("astro:page-load", kick);
		window.addEventListener("popstate", () => setTimeout(rpRenderAll, 150));
	}
</script>

<style is:global>
	/* 骨架 */
	.rp-skeleton-row {
		padding: 0.5rem 0;
	}
	.rp-skeleton-line {
		height: 0.875rem;
		border-radius: 0.375rem;
		background: var(--btn-regular-bg);
		animation: rp-pulse 1.5s ease-in-out infinite;
	}
	@keyframes rp-pulse {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0.45;
		}
	}

	/* 条目：两端同构（标题截断 + 右侧分类小字），仅行高按场景微调 */
	.rp-root .rp-item {
		padding: 0.55rem 0.25rem;
		border-radius: 0.5rem;
		min-width: 0;
	}
	.rp-root .rp-item:hover {
		background: var(--btn-regular-bg);
	}
	.rp-root .rp-compact .rp-item,
	.rp-root.rp-compact .rp-item {
		padding: 0.65rem 0.25rem;
	}
	.rp-item-divided {
		border-bottom: 1px dashed var(--line-divider);
	}
	.rp-title {
		flex: 1 1 auto;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		font-size: 0.8125rem;
		font-weight: 600;
		color: rgb(0 0 0 / 0.75);
		transition: color 0.15s;
	}
	.rp-item:hover .rp-title {
		color: var(--primary);
	}
	.dark .rp-title {
		color: rgb(255 255 255 / 0.75);
	}
	.rp-cat {
		font-size: 0.6875rem;
		color: rgb(0 0 0 / 0.35);
	}
	.dark .rp-cat {
		color: rgb(255 255 255 / 0.35);
	}
</style>
