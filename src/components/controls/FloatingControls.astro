---
import type { MarkdownHeading } from "astro";
import { siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import "@/styles/control-dock.css";
import BackToComment from "./BackToComment.astro";
import BackToHome from "./BackToHome.astro";
import BackToTop from "./BackToTop.astro";
import FloatingTOC from "./FloatingTOC.astro";
import ImmersiveReading from "./ImmersiveReading.astro";
import ImmersiveTOC from "./ImmersiveTOC.astro";

interface Props {
	headings?: MarkdownHeading[];
	encrypted?: boolean;
}

const { headings, encrypted } = Astro.props;
const immersiveReadingEnabled =
	siteConfig.post.immersiveReading?.enable !== false;
const moreLabel = i18n(I18nKey.more);
const collapseLabel = i18n(I18nKey.collapse);
---

<div class="floating-controls-container">
  <div
    id="control-dock"
    class="control-dock"
    data-side="left"
    data-open="false"
  >
    <button
      id="control-dock-toggle"
      class="dock-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="control-dock-items"
      aria-label={moreLabel}
      title={moreLabel}
      data-label-open={collapseLabel}
      data-label-closed={moreLabel}
    >
      <span class="dock-grip" aria-hidden="true">
        <i></i><i></i><i></i><i></i><i></i><i></i>
      </span>
    </button>

    <div id="control-dock-items" class="dock-items">
      <FloatingTOC headings={headings ?? []} encrypted={encrypted} />
      {immersiveReadingEnabled && (
        <>
          <ImmersiveReading />
          <ImmersiveTOC headings={headings ?? []} encrypted={encrypted} />
        </>
      )}
      <BackToComment />
      <BackToHome />
      <BackToTop />
    </div>
  </div>
</div>

<script>
  import { initControlDock } from "@/utils/control-dock";

  initControlDock();
</script>
