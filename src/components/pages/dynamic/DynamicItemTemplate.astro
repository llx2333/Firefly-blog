---
import "@/styles/markdown.css";
import "@/styles/markdown-extend.styl";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import DynamicGallery from "@/components/pages/dynamic/DynamicGallery.astro";
import DynamicInlineComments from "@/components/pages/dynamic/DynamicInlineComments.astro";
import { dynamicConfig, profileConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { url } from "@/utils/url-utils";

const profileLabel = i18n(I18nKey.dynamicProfile).replace(
	"{name}",
	profileConfig.name,
);
const profileUrl = url(dynamicConfig.profileUrl || "/about/");
---

<template data-dynamic-item-template>
	<dynamic-entry class="page-entry card-base" data-dynamic-entry>
		<article>
			<header class="page-entry-header">
				<a href={profileUrl} class="page-avatar" aria-label={profileLabel}>
					<ImageWrapper
						src={profileConfig.avatar || ""}
						alt={profileConfig.name}
						widths={[96]}
						sizes="48px"
						loading="lazy"
						fadeIn={false}
					/>
				</a>
				<div class="page-identity">
					<a href={profileUrl} class="page-author" aria-label={profileLabel}>
						<strong data-dynamic-author>{profileConfig.name}</strong>
					</a>
					<div class="page-meta">
						<a class="page-time" data-dynamic-permalink>
							<time data-dynamic-time></time>
						</a>
						<span class="page-location" data-dynamic-location hidden>
							<!-- 内联 SVG 而非 <Icon>：sprite <symbol> 落进 <template> 后不在文档树里，
							     动态页其它位置的 <use> 引用会全部失效（同 MusicPlayerView） -->
							<svg width="1em" height="1em" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M11.3 21.2q-.35-.125-.625-.375Q9.05 19.325 7.8 17.9t-2.087-2.762t-1.275-2.575T4 10.2q0-3.75 2.413-5.975T12 2t5.588 2.225T20 10.2q0 1.125-.437 2.363t-1.275 2.575T16.2 17.9t-2.875 2.925q-.275.25-.625.375t-.7.125t-.7-.125m2.113-9.787Q14 10.825 14 10t-.587-1.412T12 8t-1.412.588T10 10t.588 1.413T12 12t1.413-.587"/></svg>
							<span data-dynamic-location-text></span>
						</span>
					</div>
				</div>
				<span class="page-pinned-badge" data-dynamic-pinned hidden>
	<svg class="size-3" width="1em" height="1em" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="m16 12l2 2v2h-5v6l-1 1l-1-1v-6H6v-2l2-2V5H7V3h10v2h-1z"/></svg>
	{i18n(I18nKey.pinned)}
</span>
				<span class="page-entry-decoration" aria-hidden="true">
					<svg width="1em" height="1em" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.55 16.5L8 14q-1.65 0-2.825-1.175T4 10t1.175-2.825T8 6t2.825 1.175T12 10q0 .575-.137 1.063T11.45 12l-3.175 5.5q-.125.225-.35.363t-.5.137q-.575 0-.862-.5t-.013-1m9 0L17 14q-1.65 0-2.825-1.175T13 10t1.175-2.825T17 6t2.825 1.175T21 10q0 .575-.137 1.063T20.45 12l-3.175 5.5q-.125.225-.35.363t-.5.137q-.575 0-.862-.5t-.013-1"/></svg>
				</span>
			</header>

			<div class="page-content custom-md" data-dynamic-content></div>
			<DynamicGallery sourceId="dynamic-template-content" />
			<DynamicInlineComments src="" />
		</article>
	</dynamic-entry>
</template>
