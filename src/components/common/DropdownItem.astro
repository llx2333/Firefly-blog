---
/**
 * 公共下拉面板选项组件
 * 用于下拉面板中的选项项
 */
interface Props {
	href?: string;
	target?: string;
	/** 传入 encodeMailto() 的 base64 值时，渲染为全站邮箱弹窗（common/EmailDialog.astro）的触发按钮 */
	dataEmail?: string;
	isActive?: boolean;
	isLast?: boolean;
	class?: string;
	onclick?: string;
}

const {
	href,
	target,
	dataEmail,
	isActive = false,
	isLast = false,
	class: className,
	onclick,
} = Astro.props;

const baseClasses =
	"flex transition whitespace-nowrap items-center justify-start! w-full btn-plain scale-animation rounded-lg h-9 px-3 font-medium active:scale-95";
const spacingClass = isLast ? "" : "mb-0.5";
const activeClass = isActive ? "current-theme-btn" : "";
const allClasses =
	`${baseClasses} ${spacingClass} ${activeClass} ${className || ""}`.trim();

const Tag = dataEmail !== undefined || !href ? "button" : "a";
const isButton = Tag === "button";
---

<Tag
	href={href}
	target={target}
	type={isButton ? "button" : undefined}
	data-email-trigger={dataEmail !== undefined ? "" : undefined}
	data-email={dataEmail}
	class={isButton ? allClasses + " cursor-pointer" : allClasses}
	onclick={onclick}
>
	<slot />
</Tag>
