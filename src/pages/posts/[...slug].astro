---
import { render } from "astro:content";
import Comment from "@components/comment/index.astro";
import Markdown from "@components/common/Markdown.astro";
import EncryptedPost from "@components/features/EncryptedPost.astro";
import KatexManager from "@components/features/KatexManager.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import "@/styles/banner-post.css";
import { getSortedPosts } from "@utils/content-utils";
import {
	getCategoryUrl,
	getFileDirFromPath,
	getPostUrlBySlug,
	removeFileExtension,
} from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import CoverImage from "@/components/common/CoverImage.astro";
import PostMetadata from "@/components/layout/PostMeta.astro";
import SeriesPostsList from "@/components/misc/SeriesPostsList.astro";
import SharePoster from "@/components/misc/SharePoster.svelte";
import PostEditor from "@/components/write/PostEditor.svelte";
import { coverImageConfig } from "@/config/coverImageConfig";
import { licenseConfig } from "@/config/licenseConfig";
import { profileConfig } from "@/config/profileConfig";
import { siteConfig } from "@/config/siteConfig";
import { sponsorConfig } from "@/config/sponsorConfig";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { getApiUrlList, processCoverImageSync } from "@/utils/image-utils";
import {
	getAuthorAvatarUrl,
	getSiteLogo,
	toAbsoluteImageInfo,
} from "@/utils/schema-image";
import {
	buildBreadcrumbList,
	buildPersonEntity,
	buildPublisherEntity,
	toAbsoluteUrl,
} from "@/utils/schema-utils";
import { url } from "@/utils/url-utils";

const showSponsorButton =
	sponsorConfig.showButtonInPost && siteConfig.pages.sponsor;
const showLicenseRow =
	licenseConfig.enable || siteConfig.post.share || showSponsorButton;

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();
	return blogEntries.map((entry) => {
		// 将 id 转换为 slug（移除扩展名）以匹配路由参数
		const slug = removeFileExtension(entry.id);
		return {
			params: { slug },
			props: { entry },
		};
	});
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// 内容层 entry.id 不带扩展名，GitHub 端文件名必须有 → 从 filePath 截取（兜底 .md）
const postFileName =
	(entry.filePath ?? "").replace(
		/^(?:.*[\\/])?src[\\/]+content[\\/]+posts[\\/]+/,
		"",
	) || `${entry.id.replace(/^\//, "")}.md`;

const { remarkPluginFrontmatter } = await render(entry);

const bannerPostMeta = {
	title: entry.data.title,
	description: entry.data.description,
	published: entry.data.published,
	updated: entry.data.updated,
	words: remarkPluginFrontmatter.words,
	minutes: remarkPluginFrontmatter.minutes,
};

// 处理随机图：如果image为"api"，则从配置的API获取随机图
const processedImage = processCoverImageSync(entry.data.image, entry.id);
const apiUrls = getApiUrlList(entry.data.image, entry.id);
const showPostCover = Boolean(processedImage && coverImageConfig.enableInPost);
const usePostCoverOverlay =
	showPostCover && (coverImageConfig.enableInPostOverlay ?? true);

const getDirectImageUrl = (src: string | undefined): string | null => {
	if (!src) return null;
	if (
		src.startsWith("http://") ||
		src.startsWith("https://") ||
		src.startsWith("//") ||
		src.startsWith("data:")
	) {
		return src;
	}
	return src.startsWith("/") ? url(src) : null;
};

// 海报优先复用页面上已经优化过的图片，本地源路径不再单独导入。
const posterCoverUrl = showPostCover ? null : getDirectImageUrl(processedImage);
const posterCoverSelector = showPostCover ? "#post-cover img" : null;
const posterAvatarUrl = getDirectImageUrl(profileConfig.avatar);
const posterAvatarSelector = profileConfig.avatar
	? ".profile-avatar-image img"
	: null;

dayjs.extend(utc);

const coverBasePath = getFileDirFromPath(entry.filePath || "");
const coverImage =
	(await toAbsoluteImageInfo(
		processedImage,
		coverBasePath,
		siteConfig.site_url,
	)) ?? undefined;

// 作者个人页（/about/）绝对 URL，用于 author.url 指向唯一标识作者的页面
const aboutUrl =
	toAbsoluteUrl("/about/", siteConfig.site_url) ?? siteConfig.site_url;

// 作者实体：与首页/about 的 Person 共用同一 @id（#person），author 用 @id 关联
const authorAvatarUrl = await getAuthorAvatarUrl();
const authorPerson = buildPersonEntity({
	site: siteConfig.site_url,
	profileConfig,
	authorUrl: aboutUrl,
	avatarUrl: authorAvatarUrl,
	description: profileConfig.bio,
});

// publisher 实体（Organization，含真实 logo），article 的 publisher 用其 @id 关联
const publisher = buildPublisherEntity({
	site: siteConfig.site_url,
	siteConfig,
	logo: await getSiteLogo(),
});

const breadcrumbItems = [
	{
		name: i18n(I18nKey.home),
		url: toAbsoluteUrl("/", siteConfig.site_url) ?? siteConfig.site_url,
	},
];
if (entry.data.category) {
	breadcrumbItems.push({
		name: entry.data.category,
		url:
			toAbsoluteUrl(getCategoryUrl(entry.data.category), siteConfig.site_url) ??
			siteConfig.site_url,
	});
}
breadcrumbItems.push({ name: entry.data.title, url: Astro.url.toString() });

const breadcrumbList = buildBreadcrumbList(breadcrumbItems);

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "BlogPosting",
			headline: entry.data.title,
			description: entry.data.description || entry.data.title,
			keywords: entry.data.tags.length ? entry.data.tags.join(", ") : undefined,
			author: { "@id": authorPerson["@id"] },
			publisher: { "@id": publisher["@id"] },
			...(coverImage
				? {
						image: {
							"@type": "ImageObject",
							url: coverImage.url,
							contentUrl: coverImage.url,
							...(coverImage.width ? { width: coverImage.width } : {}),
							...(coverImage.height ? { height: coverImage.height } : {}),
						},
					}
				: {}), // 优化：有封面才输出，避免 image:null
			datePublished: entry.data.published.toISOString(),
			...(entry.data.category ? { articleSection: entry.data.category } : {}),
			...(remarkPluginFrontmatter.words
				? { wordCount: remarkPluginFrontmatter.words }
				: {}),
			...(entry.data.updated
				? { dateModified: entry.data.updated.toISOString() }
				: {}),
			mainEntityOfPage: { "@type": "WebPage", "@id": Astro.url.toString() },
			url: Astro.url.toString(),
			inLanguage: entry.data.lang
				? entry.data.lang.replace("_", "-")
				: siteConfig.lang.replace("_", "-"),
		},
		authorPerson,
		publisher,
		breadcrumbList,
	],
};

// 系列块两端共用（侧栏 widget / 移动端文末块），数据由 SeriesPostsList 客户端计算；
// 这里只在 SSR 阶段判断有无系列，避免无系列文章出现骨架闪烁
const hasSeries = entry.data.series.trim() !== "";
// 文末协议行：单文章许可证优先，回退站点默认（原 License.astro 的解析规则）
const licenseName = entry.data.licenseName || licenseConfig.name;
const licenseHref = entry.data.licenseName
	? entry.data.licenseUrl || undefined
	: licenseConfig.url;
---

<MainGridLayout
  title={entry.data.title}
  description={entry.data.description || entry.data.title}
  lang={entry.data.lang}
  setOGTypeArticle={true}
  postSlug={entry.id}
  postCoverImage={coverImage?.url}
  postCategory={entry.data.category || undefined}
  ogImageWidth={coverImage?.width}
  ogImageHeight={coverImage?.height}
  ogImageAlt={entry.data.title}
  headings={headings}
  encrypted={!!entry.data.password}
  bannerPostMeta={bannerPostMeta}
>
  <!-- KaTeX 按需加载 - 仅在文章页面 -->
  <KatexManager slot="head" />

  <!-- og:article 结构化元数据 -->
  <meta slot="head" property="article:published_time" content={entry.data.published.toISOString()} />
  {entry.data.updated && (
    <meta slot="head" property="article:modified_time" content={entry.data.updated.toISOString()} />
  )}
  <meta slot="head" property="article:author" content={entry.data.author || profileConfig.name} />
  {entry.data.category && (
    <meta slot="head" property="article:section" content={entry.data.category} />
  )}
  {entry.data.tags.map((tag) => (
    <meta slot="head" property="article:tag" content={tag.trim()} />
  ))}
  {/* 加密/密码保护文章：内容不可被爬取，标注 noindex, noarchive */}
  {entry.data.password && (
    <meta slot="head" name="robots" content="noindex, noarchive" />
  )}

  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />
  <div
    class="flex w-full rounded-(--radius-large) overflow-hidden relative mb-4"
  >
    <div
      id="post-container"
      class:list={[
        "card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full ",
        {},
      ]}
    >
      <PostEditor
        client:load
        fileName={postFileName}
        initialTitle={entry.data.title}
      />
      {
        usePostCoverOverlay && processedImage && (
          <div class="-mx-6 md:-mx-9 -mt-6 mb-6 h-48 md:h-64 relative onload-animation">
            <CoverImage
              id="post-cover"
              src={processedImage}
              basePath={getFileDirFromPath(entry.filePath || "")}
              alt={entry.data.title}
              class="h-full"
              preview={false}
              apiUrls={apiUrls}
            />
            <div class="absolute inset-x-4 top-3 z-10 flex flex-wrap items-center justify-end gap-x-3 gap-y-1 text-xs font-medium text-white drop-shadow-[0_1px_2px_rgb(0_0_0/0.9)]">
              <div class="flex items-center gap-1 whitespace-nowrap">
                <Icon name="material-symbols:notes-rounded" class="text-base" />
                <span>
                  {remarkPluginFrontmatter.words}
                  {" " + i18n(remarkPluginFrontmatter.words === 1 ? I18nKey.wordCount : I18nKey.wordsCount)}
                </span>
              </div>
              <div class="flex items-center gap-1 whitespace-nowrap">
                <Icon name="material-symbols:schedule-outline-rounded" class="text-base" />
                <span>
                  {remarkPluginFrontmatter.minutes}
                  {" " + i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}
                </span>
              </div>
              {entry.data.password && (
                <div class="flex items-center gap-1 whitespace-nowrap">
                  <Icon name="material-symbols:lock-outline" class="text-base" />
                  <span>{i18n(I18nKey.postEncrypted)}</span>
                </div>
              )}
            </div>
            <div class="absolute inset-x-0 bottom-0 px-6 md:px-9 pt-10 pb-3 bg-gradient-to-t from-black/80 via-black/45 to-transparent">
              <div
                data-pagefind-body
                data-pagefind-weight="10"
                data-pagefind-meta="title"
                class="mb-2 text-xl md:text-2xl font-bold leading-tight text-white"
              >
                {entry.data.title}
              </div>
              <div class="flex flex-wrap items-center">
                <PostMetadata
                  variant="cover"
                  className="gap-x-4 gap-y-1"
                  published={entry.data.published}
                  updated={entry.data.updated}
                  category={entry.data.category || undefined}
                  tags={entry.data.tags}
                  id={entry.id}
                />
                <!-- 编辑按钮槽位：PostEditor 待机态 portal 进来（认证后才显示） -->
                <span id="post-edit-slot" data-variant="cover" class="ml-auto"></span>
              </div>
            </div>
          </div>
        )
      }

      <!-- word count and reading time -->
      {
        !usePostCoverOverlay && (
          <div
            class="flex flex-row text-black/30 dark:text-white/30 gap-5 mb-3 transition onload-animation"
          >
            <div class="flex flex-row items-center">
              <div
                class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2"
              >
                <Icon name="material-symbols:notes-rounded" />
              </div>
              <div class="text-sm">
                {remarkPluginFrontmatter.words}
                {" " + i18n(I18nKey.wordsCount)}
              </div>
            </div>
            <div class="flex flex-row items-center">
              <div
                class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2"
              >
                <Icon name="material-symbols:schedule-outline-rounded" />
              </div>
              <div class="text-sm">
                {remarkPluginFrontmatter.minutes}
                {
                  " " +
                    i18n(
                      remarkPluginFrontmatter.minutes === 1
                        ? I18nKey.minuteCount
                        : I18nKey.minutesCount
                    )
                }
              </div>
            </div>
            {entry.data.password && (
              <div class="flex flex-row items-center">
                <div
                  class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2"
                >
                  <Icon name="material-symbols:lock-outline" />
                </div>
                <div class="text-sm">
                  {i18n(I18nKey.postEncrypted)}
                </div>
              </div>
            )}
          </div>
        )
      }

      <!-- title -->
      {
        !usePostCoverOverlay && (
          <div class="relative onload-animation">
            <div
              data-pagefind-body
              data-pagefind-weight="10"
              data-pagefind-meta="title"
              class="transition w-full block font-bold mb-3
                        text-3xl md:text-[2.25rem]/[2.75rem]
                        text-black/90 dark:text-white/90
                        md:before:w-1 before:h-5 before:rounded-md before:bg-(--primary)
                        before:absolute before:top-3 before:-left-4.5"
            >
              {entry.data.title}
            </div>
          </div>
        )
      }

      <!-- metadata -->
      {
        !usePostCoverOverlay && (
          <div class="onload-animation">
            <div class="mb-5 flex flex-wrap items-center">
              <PostMetadata
                published={entry.data.published}
                updated={entry.data.updated}
                tags={entry.data.tags}
                category={entry.data.category || undefined}
                id={entry.id}
              />
              <!-- 编辑按钮槽位：PostEditor 待机态 portal 进来（认证后才显示） -->
              <span id="post-edit-slot" class="ml-auto"></span>
            </div>
            {
              !showPostCover && (
                <div class="border-(--line-divider) border-dashed border-b mt-3 mb-5" />
              )
            }
          </div>
        )
      }

      {
        showPostCover && !usePostCoverOverlay && processedImage && (
          <div class="mt-4">
            <CoverImage
              id="post-cover"
              src={processedImage}
              basePath={getFileDirFromPath(entry.filePath || "")}
              alt={entry.data.title}
              class="mb-8 rounded-xl onload-animation"
              preview={false}
              naturalHeight
              apiUrls={apiUrls}
            />
          </div>
        )
      }

      {entry.data.password ? (
        <EncryptedPost password={entry.data.password} slug={entry.id} hint={entry.data.passwordHint}>
          <Markdown class="mb-6 markdown-content onload-animation">
            <Content />
          </Markdown>
        </EncryptedPost>
      ) : (
        <>
          <Markdown class="mb-6 markdown-content onload-animation">
            <Content />
          </Markdown>
        </>
      )}

      {/* 文末协议行：版权 + 许可证 + 转载说明 + 分享/打赏小按钮，替代原分享大卡与协议大卡 */}
      {
        showLicenseRow && (
          <div class="mt-2 pt-4 border-t border-dashed border-(--line-divider) flex items-center flex-wrap gap-y-1.5 gap-x-3 text-sm text-black/60 dark:text-white/60">
            {licenseConfig.enable && (
              <span class="flex items-center flex-wrap gap-y-1.5 gap-x-3 min-w-0">
                <span class="whitespace-nowrap">
                  © {entry.data.published.getFullYear()} {entry.data.author ||
                  profileConfig.name}
                </span>
                <a
                  href={licenseHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="link text-(--primary) whitespace-nowrap"
                >
                  {licenseName}
                </a>
                <span class="min-w-0">{i18n(I18nKey.licenseNote)}</span>
              </span>
            )}
            <div class="ml-auto flex items-center gap-2">
              {siteConfig.post.share && (
                <SharePoster
                  client:load
                  compact={true}
                  title={entry.data.title}
                  author={entry.data.author || profileConfig.name}
                  description={entry.data.description || entry.data.title}
                  pubDate={formatDateToYYYYMMDD(entry.data.published)}
                  coverImage={posterCoverUrl}
                  coverImageSelector={posterCoverSelector}
                  url={Astro.url.href}
                  siteTitle={siteConfig.title}
                  avatar={posterAvatarUrl}
                  avatarSelector={posterAvatarSelector}
                />
              )}
              {showSponsorButton && (
                <a
                  href={url("/sponsor/")}
                  class="btn-regular rounded-lg h-8 px-3 gap-1.5 text-sm hover:scale-105 active:scale-95 whitespace-nowrap"
                >
                  <span>{i18n(I18nKey.sponsor)}</span>
                  <Icon name="fa7-solid:arrow-right" class="text-xs" />
                </a>
              )}
            </div>
          </div>
        )
      }
    </div>
  </div>

  <!-- 文章卡片之外的附加区：原位编辑时整体隐藏 -->
  <div id="post-extras">
  <!-- 上次编辑时间 -->
  {
    siteConfig.post.showLastModified && (() => {
      const lastModified = dayjs(entry.data.updated || entry.data.published);
      const dateStr = lastModified.format("YYYY-MM-DD");
      const outdatedThreshold = siteConfig.post.outdatedThreshold ?? 1;

      // 1. 預設加上 hidden 隱藏，並把時間與閾值綁在 data-* 屬性
      return (
        <div
          id="outdated-card"
          class="mb-4 hidden text-sm text-black/60 dark:text-white/60"
          data-date={lastModified.toISOString()}
          data-threshold={outdatedThreshold}
        >
          <div class="flex items-center gap-1.5">
            <Icon
              name="material-symbols:history-rounded"
              class="text-lg text-(--primary) shrink-0"
            />
            <span class="min-w-0">
              {i18n(I18nKey.lastModifiedPrefix)}{dateStr}
              <span id="days-ago-text" data-template={i18n(I18nKey.lastModifiedDaysAgo)}></span>
            </span>
          </div>
          <p id="outdated-warning" class="hidden mt-0.5 pl-6 text-[0.8rem] leading-tight text-black/55 dark:text-white/55">
            {i18n(I18nKey.lastModifiedOutdated)}
          </p>
        </div>
      );
    })()
  }

  <script>
    const card = document.getElementById('outdated-card');
    const dateStr = card?.dataset.date;

    if (card && dateStr) {
      // 讀取伺服器給的日期，用原生 Date 算出差異天數（避免向客戶端打包整個 dayjs）
      const lastModified = new Date(dateStr);
      const daysDiff = Math.floor(
        (Date.now() - lastModified.getTime()) / 86400000,
      );
      const threshold = Number(card.dataset.threshold);

      // 如果超過閾值，就顯示卡片與提示文字
      if (daysDiff >= threshold) {
        card.classList.remove('hidden');

        if (daysDiff >= 1) {
          const textEl = document.getElementById('days-ago-text');
          if (textEl && textEl.dataset.template) {
            textEl.textContent = `，${textEl.dataset.template.replace("{days}", daysDiff.toString())}`;
          }

          const warningEl = document.getElementById('outdated-warning');
          if (warningEl) {
            warningEl.classList.remove('hidden');
          }
        }
      }
    }
  </script>

  {
    siteConfig.post.postNavigation && (
      <nav class="flex flex-row items-center justify-center gap-2 sm:gap-3 mb-4 w-full min-w-0" data-post-nav>
    <a
      href={entry.data.nextSlug ? getPostUrlBySlug(entry.data.nextSlug) : url("/")}
      class="flex-1 min-w-0 max-w-[13rem] font-bold active:scale-95 transition"
    >
      <div class="btn-card rounded-xl w-full h-10 px-3 flex items-center justify-start! gap-2">
        <Icon
          name="material-symbols:chevron-left-rounded"
          class="text-[1.15rem] shrink-0 text-(--primary)"
        />
        <div class="overflow-hidden text-ellipsis whitespace-nowrap min-w-0 text-[0.9375rem] sm:text-sm text-black/75 dark:text-white/75">
          {entry.data.nextTitle || i18n(I18nKey.home)}
        </div>
      </div>
    </a>

    <a
      href={entry.data.prevSlug ? getPostUrlBySlug(entry.data.prevSlug) : url("/")}
      class="flex-1 min-w-0 max-w-[13rem] font-bold active:scale-95 transition"
    >
      <div class="btn-card rounded-xl w-full h-10 px-3 flex items-center justify-end! gap-2">
        <div class="overflow-hidden text-ellipsis whitespace-nowrap min-w-0 text-[0.9375rem] sm:text-sm text-black/75 dark:text-white/75">
          {entry.data.prevTitle || i18n(I18nKey.home)}
        </div>
        <Icon
          name="material-symbols:chevron-right-rounded"
          class="text-[1.15rem] shrink-0 text-(--primary)"
        />
      </div>
    </a>
      </nav>
    )
  }

  {
    // 移动端「所属系列」块（桌面走右侧栏 widget，两端同一客户端列表组件）
    hasSeries && (
      <div data-sp-block class="md:hidden mb-4">
        <div class="card-base p-5">
          <div class="flex items-center gap-2 mb-2">
            <Icon
              name="material-symbols:format-list-bulleted"
              class="text-xl text-(--primary) shrink-0"
            />
            <h3 class="font-bold text-lg text-black/75 dark:text-white/75">
              {i18n(I18nKey.seriesPartOf)}
            </h3>
          </div>
          <SeriesPostsList variant="compact" currentId={entry.id} />
        </div>
      </div>
    )
  }

  <!-- 评论 -->
  {entry.data.comment && !entry.data.password && <Comment post={entry} />}
  </div>
</MainGridLayout>
